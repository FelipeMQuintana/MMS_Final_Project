```{r}
# Experimental Scenario
run_scenario <- function(ov = list(), label = "base") {
  # Save the current globals we might change, and restore them when the function ends
  keep <- unique(c(names(ov), "basres", "Ptmax"))
  old  <- mget(keep, envir = globalenv())
  on.exit(list2env(old, envir = globalenv()), add = TRUE)
  list2env(ov, envir = globalenv())   
  # Listening to environment and apply overrides (e.g. list(I0 = 50))

  # Derived parameters depend on Um, so recompute them unless set explicitly
  if (!"basres" %in% names(ov)) assign("basres", 0.05 * Um, envir = globalenv())
  if (!"Ptmax"  %in% names(ov)) assign("Ptmax", 4 * Um * 0.012, envir = globalenv())

  # Quantities that depend on tmax, dt, t_inj are recomputed locally
  nt <- round(tmax / dt); inj_step <- round(t_inj / dt) + 1
  inj_layers <- which(z <= 5)

  # Initial conditions (same as chunk 4)
  B <- rep(B0, nz); Nq <- NC0 * B; Pq <- PC0 * B; Chl <- ChlC0 * B
  A <- rep(A0, nz); Pw <- rep(P0, nz); DIC <- rep(DIC0, nz)

  # Only store what the summary metrics need (not the full time x depth matrices)
  nsave <- nt %/% save_every + 1
  out <- data.frame(time = numeric(nsave), Chl_max = NA_real_, Chl_int = NA_real_,
                    mu_max = NA_real_, NP_mol = NA_real_)
  isave <- 0

  for (step in 1:(nt + 1)) {
    t <- (step - 1) * dt
    if (step == inj_step) {                    # nutrient pulse
      A[inj_layers]   <- A[inj_layers]   + inj["A"]
      Pw[inj_layers]  <- Pw[inj_layers]  + inj["P"]
      DIC[inj_layers] <- DIC[inj_layers] + inj["C"]
    }
    Bs <- pmax(B, 1e-9)
    NC <- Nq / Bs; PC <- Pq / Bs; ChlC <- Chl / Bs    
    # quotas derived from pools
    Nu <- NCu(NC); Pu <- PCu(PC); NP <- NPCu(Nu, Pu)  
    # NP here = NPCu (limitation index)

    k   <- kw + kc * Chl                               
    # light attenuation with self-shading
    tau <- cumsum(k * dz) - k * dz / 2
    PFD <- I0 * exp(-tau)

    Pqm <- pmax((Um * (1 + 1.5 * NCm) + basres) * NP, 1e-9)
    PS  <- Pqm * tanh(alpha * PFD * 86400 * ChlC / Pqm) * DIC / (DIC + Kc)

    At <- Atq(NC) * A / (A + Akt) * clamp01((NCm - NC) / (NCm - NCo))
    Pt <- Ptmax * Pw / (Pw + Pkt) * clamp01((PCm - PC) / (PCm - PCo))
    At <- pmin(At, A / (Bs * dt)); Pt <- pmin(Pt, Pw / (Bs * dt))  
    # pools can't go negative

    Cu  <- PS - 1.5 * At - basres
    syn <- ChlCm * NP * M * Um * clamp01(1 - PS / Pqm) * clamp01(1 - ChlC / ChlCm)

    if ((step - 1) %% save_every == 0) {               
      # record snapshot
      isave <- isave + 1
      out$time[isave]    <- t
      out$Chl_max[isave] <- max(Chl)
      out$Chl_int[isave] <- sum(Chl) * dz
      out$mu_max[isave]  <- max(Cu)
      out$NP_mol[isave]  <- (sum(Nq) / sum(Pq)) * 31 / 14   
      # biomass-weighted cellular N:P
    }
    if (step > nt) break

    dB   <- B * (Cu - mort)      + transport(B, w)
    dNq  <- At * B - mort * Nq   + transport(Nq, w)
    dPq  <- Pt * B - mort * Pq   + transport(Pq, w)
    dChl <- B * syn - mort * Chl + transport(Chl, w)
    dA   <- -At * B + mort * Nq  + transport(A)
    dPw  <- -Pt * B + mort * Pq  + transport(Pw)
    dDIC <- -Cu * B + mort * B   + transport(DIC)

    B <- pmax(B + dt * dB, 0);    Nq <- pmax(Nq + dt * dNq, 0)
    Pq <- pmax(Pq + dt * dPq, 0); Chl <- pmax(Chl + dt * dChl, 0)
    A <- pmax(A + dt * dA, 0);    Pw <- pmax(Pw + dt * dPw, 0)
    DIC <- DIC + dt * dDIC
  }
  out$label <- label
  out
}

