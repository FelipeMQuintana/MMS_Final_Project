  mix_10        = list(Kz = rep(10,  nz - 1)),
  mix_50        = list(Kz = rep(50,  nz - 1)),                 
  # explicit-Euler limit is roughly Kz < 60
  timing_10     = list(t_inj = 10),
  Pkt_62        = list(Pkt = 62),                              
  # Flynn's published value
  swim_up2      = list(w = 2),                                 
  # swimming up 2 m/d
  # Extreme "does it break?" controls
  ctrl_noinject = list(t_inj = 999),                           
  # injection never happens
  ctrl_dark     = list(I0 = 0)
)

res <- do.call(rbind, Map(run_scenario, scen, names(scen)))

# ---- Bloom metrics per scenario ----
summ <- do.call(rbind, lapply(split(res, res$label), function(d) {
  above <- which(d$Chl_max >= bloom_thresh)                    
  # same bloom definition as before
  data.frame(label = d$label[1],
             peak_Chl = round(max(d$Chl_max), 1),
             t_peak   = d$time[which.max(d$Chl_max)],
             onset    = if (length(above)) d$time[min(above)] else NA,
             end      = if (length(above)) d$time[max(above)] else NA,
             max_mu   = round(max(d$mu_max), 2),
             NP_at_end = round(tail(d$NP_mol, 1), 1))
}))
print(summ, row.names = FALSE)

# ---- Plot: each parameter group vs the base case ----
res$group <- sub("_.*", "", res$label)
base_df <- res[res$label == "base", ]
plot_df <- do.call(rbind, lapply(setdiff(unique(res$group), "base"), function(g)
  rbind(transform(base_df, group = g), res[res$group == g, ])))
ggplot(plot_df, aes(time, Chl_int, colour = label)) +
  geom_line(linewidth = 0.8) +
  geom_vline(xintercept = t_inj, linetype = "dashed") +
  facet_wrap(~ group, scales = "free_y") +
  labs(x = "Time (d)", y = "Depth-integrated Chl a (mg/m2)") +
  theme_bw(base_size = 9)
