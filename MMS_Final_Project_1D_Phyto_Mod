## ---- 6. Diagnostics -------------------------------------------------------
# Clarification: "d" is meant to represent the # of total days
Btot    <- rowSums(O$B) * dz                    # Total biomass mg C m-2
Chl_int <- rowSums(O$Chl) * dz                  # Chlorophyll intake mg Chl m-2
Chl_max <- apply(O$Chl, 1, max)                 # Max chlorophyll value ug L-1
NC_mean <- rowSums(O$Nq) / rowSums(O$B)       # avg N:C biomass-weighted quotas
PC_mean <- rowSums(O$Pq) / rowSums(O$B)       # avg P:C biomass weighted quotas
                                                # these quotas are referring to 
                                                # the redfield ratio

CN <- (1 / NC_mean) * 14 / 12                # molar ratios necessary for growth
NP <- (NC_mean / PC_mean) * 31 / 14
CP <- (1 / PC_mean) * 31 / 12
Redfield <- c(CN = 106 / 16, NP = 16, CP = 106)

r_net <- diff(log(Btot)) / diff(t_out)              # net population growth (d-1)
above <- which(Chl_max >= bloom_thresh) # chlorophyll max must be greater than 
                                        # bloom thresh hold in order for a 
                                        # bloom to be counted. 
# categorizing steps
# just to clarify (d) is the time variable indicating fractions of one day
cat("\n--- Bloom metrics (threshold =", bloom_thresh, "ug Chl L-1) ---\n")
cat("Max net population growth rate (d-1):", round(max(r_net), 2), "\n")
cat("Max specific growth rate Cu (d-1):   ", round(max(O$mu), 2), "\n")
if (length(above) > 0) {
  t_on <- t_out[min(above)]; t_off <- t_out[max(above)]
  cat("Bloom onset (d):", t_on, " peak (d):", t_out[which.max(Chl_max)],
      " end (d):", t_off, " residence (d):", t_off - t_on, "\n")
} else cat("No bloom exceeded the threshold.\n")
exp_N <- sum((A0 + NC0 * B0) * dz * rep(1, nz)) + ifelse(t_out >= t_inj, inj["A"] * length(inj_layers) * dz, 0)
exp_P <- sum((P0 + PC0 * B0) * dz * rep(1, nz)) + ifelse(t_out >= t_inj, inj["P"] * length(inj_layers) * dz, 0)
cat("Max N budget error (%):", signif(100 * max(abs(Ntot - exp_N) / exp_N), 2),
    "| P:", signif(100 * max(abs(Ptot - exp_P) / exp_P), 2), "\n")
