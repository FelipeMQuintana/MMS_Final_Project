###############################################################################
# Heterosigma akashiwo: simple 1-D (time x depth) model with variable C:N:P
# Template: Flynn (2001) J Plankton Res 23:977-997
# Disclosure: Claude Sonnet 5.5 was used to write and debug portions of the
# code contained in this model. All equations and values derived from publications
# were manually double checked to ensure accuracy. 
#
# State variables (per layer, extensive, ug L-1):
# B = biomass C            
# Nq = cell N (= NC * B)      
# Pq = cell P (= PC * B)
# Chl = chlorophyll a (= ChlC * B)
# A = ammonium N           
# Pw = dissolved inorganic P   
# DIC = dissolved inorganic C
# Quotas NC, PC, ChlC (g g-1 C) are derived as Nq/B, Pq/B, Chl/B, so cellular
# C:N:P varies freely (no fixed Redfield ratio).
#
# SIMPLIFICATIONS relative to Flynn (2001):
#   - one N source (ammonium); no glutamine pool (GC) feedback -> replaced by a
#     linear down-regulation of uptake as the quota approaches its maximum
#   - one P quota (IPC + OPC merged); no Fe, Si or cell-size/division
#   - daily-mean light (Flynn's allowed simplification: no dark reserves)
#   - added (not in Flynn): linear mortality with full remineralization,
#     vertical diffusion, optional swimming/sinking, a DIC limitation term
# Values marked PLACEHOLDER are guesses to be replaced with H. akashiwo data.
###############################################################################

## ---- 1. Grid and time -----------------------------------------------------
zmax <- 20; dz <- 1; nz <- zmax / dz
z    <- seq(dz / 2, zmax - dz / 2, by = dz)      # layer midpoints (m)
tmax <- 30                                       # run length (d)
dt   <- 1 / 128                                  # time step (d), as in Flynn
nt   <- round(tmax / dt)
save_every <- 16                                 # save every 1/8 d


```

```{r}
## ---- 2. Parameters --------------------------------------------------------
# Growth / photosynthesis (Flynn 2001, Table III)
Um     <- 1            # max growth rate (d-1); PLACEHOLDER for H. akashiwo
alpha  <- 8e-6         # Chl-specific initial slope (per umol m-2 d-1 basis)
ChlCm  <- 0.09         # max Chl:C (g Chl g-1 C)
M      <- 2            # photoacclimation scalar
basres <- 0.05 * Um    # basal respiration (d-1), simplified constant
# Quotas (g g-1 C)
NCm <- 0.15; NCo <- 0.05; NCk <- 1
PCm <- 0.0235          # = IPCm + OPCm from Flyn Table III (Max P:C ratio) 
PCo <- 0.005           # Miniumum P:C ratio threshold PLACEHOLDER
PCk <- 0.009
# Ammonium transport capacity, Flynn Eq. 2 (constants supplied)
A1 <- -0.705; A2 <- 0.982; A3 <- -1.061; A4 <- 5.34
# Environment / uptake constants (ug L-1)
Akt   <- 14            # half-saturation, ammonium (ug N L-1), Flynn
Pkt   <- 3             # PLACEHOLDER; half-saturation, phosphate (ug P L-1)
Ptmax <- 4 * Um * 0.012  # max P uptake = 4 x Um x OPCm (Flynn)
Kc    <- 600           # half-saturation, DIC (ug C L-1); PLACEHOLDER
mort  <- 0.05          # mortality/grazing (d-1), remineralized; PLACEHOLDER
# Light
I0 <- 200              # daily-mean surface PFD (umol photons m-2 s-1)
kw <- 0.1              # background attenuation (m-1); PLACEHOLDER
kc <- 0.02             # Chl-specific attenuation (m2 mg-1 Chl); typical value
# Physics
Kz <- rep(1, nz - 1)   # eddy diffusivity at layer interfaces (m2 d-1)
w  <- 0                # swimming speed, + = up (m d-1); 0 = off, PLACEHOLDER
# Initial conditions
B0 <- 5; NC0 <- 0.10; PC0 <- 0.012; ChlC0 <- 0.05
A0 <- 5; P0 <- 0.5; DIC0 <- 24000

# Injection (ug L-1), added to the layers listed at time t_inj
t_inj <- 5
inj_layers <- which(z <= 5)
inj <- c(A = 140, P = 19, C = 800)    # ~10 uM N, ~0.6 uM P (N:P ~16), 66 uM C
# Bloom definition
bloom_thresh <- 10     # max Chl a in water column (ug L-1); arbitrary
```

```{r}
## ---- 3. Functions ---------------------------------------------------------
clamp01 <- function(x) pmin(1, pmax(0, x))

# Equation 2: Maximum value of ammonnium transport with N status of cells
# $A1 * (1 - exp^A2 * (1/NC - A4)) * exp^A3 * (1/NC - A4)$
Atq <- function(NC) {                       # Flynn Eq. 2
  x <- 1 / NC - A4
  ifelse(x > 0, Um * A1 * (1 - exp(A2 * x)) * exp(A3 * x), 0)
}

# This equation describes growth rate relative to NC, given the quotent NCu. 
# In some circumstances growth can exceed NCm(when growth is limtied by another)
# nutrient, but NCu of course cannot exceed 1. 
NCu <- function(NC) {                       # normalized N status (Eq. 8)
  ifelse(NC >= NCm, 1,
         pmax(0, NC - NCo) / (pmax(0, NC - NCo) + NCk) * (NCm - NCo + NCk) / (NCm - NCo))
}

# Normalized P quota regulatory parameter analogous to NCu. This is meant 
# to turn the cell's phosphorus content into a 0-1 index of P status, called
# PCu. This is what lets P limitation act on growth. PCo is the mimumum substance
# quota, and PCm is the maximum quota, with PCk acting as the half saturation 
# constant. 
# 
PCu <- function(PC) {                       # normalized P status (Eq. 28)
  ifelse(PC >= PCm, 1,
         pmax(0, PC - PCo) / (pmax(0, PC - PCo) + PCk) * (PCm - PCo + PCk) / (PCm - PCo))
}

NPCu <- function(Nu, Pu) {                  # N-P interaction (Eq. 29)
  ifelse(Nu > Pu, Pu * (1 - Pu + Pu * Nu), Nu * (1 - Nu + Pu * Nu))
}
transport <- function(X, w = 0) {           # diffusion (+ upwind swimming)
  Fi <- -Kz * (X[-1] - X[-nz]) / dz         # downward flux at interfaces
  if (w != 0) Fi <- Fi - w * (if (w > 0) X[-1] else X[-nz])
  Fl <- c(0, Fi, 0)                         # no flux at surface or bottom
  -(Fl[-1] - Fl[-(nz + 1)]) / dz
}

```

