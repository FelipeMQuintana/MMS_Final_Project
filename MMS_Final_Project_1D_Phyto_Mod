## ---- 4. Initialize --------------------------------------------------------
# This step is mean to start the simulation and create placeholder matrixes
# for the results to be stored in. This also calculates when nutrient 
# injections occur as a time step. 

B   <- rep(B0, nz); Nq <- NC0 * B; Pq <- PC0 * B; Chl <- ChlC0 * B 
# Phytoplankton biomass as carbon (ug C/L)

A   <- rep(A0, nz); Pw <- rep(P0, nz); DIC <- rep(DIC0, nz)
# Dissolved ammonium nitrogen (ug N/L)

nsave <- nt %/% save_every + 1 # How many snapshots will be saved
t_out <- numeric(nsave) # Time of each "snapshot" of results
mk <- function() matrix(NA_real_, nsave, nz) # Creating an empty matrix for results
# to be filed in
O <- list(B = mk(), Nq = mk(), Pq = mk(), Chl = mk(),
          A = mk(), Pw = mk(), DIC = mk(), mu = mk(), PS = mk(), PFD = mk())
Ntot <- Ptot <- Ctot <- numeric(nsave) # Stores the total mass of N, P, C at 
# each saved time
isave <- 0 # Counter for which snapshot row to write next
inj_step <- round(t_inj / dt) + 1 # Injection step timing. 
```

```{r}
## ---- 5. Time loop ---------------------------------------
# This time loop step uses the explicit Euler equation 
# where the new value = old value + time step * rate. With a timestep of 
# dt = 1/128 per day, each step is about 11 minutes long. 
for (step in 1:(nt + 1)) {
  t <- (step - 1) * dt
  if (step == inj_step) {                 # initial nutrient injection
    A[inj_layers]   <- A[inj_layers]   + inj["A"]
    Pw[inj_layers]  <- Pw[inj_layers]  + inj["P"]
    DIC[inj_layers] <- DIC[inj_layers] + inj["C"]
  }

  Bs <- pmax(B, 1e-9) # Biomass as carbon 
  NC <- Nq / Bs; PC <- Pq / Bs; ChlC <- Chl / Bs
  Nu <- NCu(NC); Pu <- PCu(PC); NP <- NPCu(Nu, Pu)


  # light with self-shading (Beer-Lambert, Chl in ug L-1 = mg m-3)
  k   <- kw + kc * Chl
  tau <- cumsum(k * dz) - k * dz / 2
  PFD <- I0 * exp(-tau)

  # photosynthesis production step (Jassby-Platt tanh, Flynn Eq. 20)
  Pqm <- pmax((Um * (1 + 1.5 * NCm) + basres) * NP, 1e-9)
  PS  <- Pqm * tanh(alpha * PFD * 86400 * ChlC / Pqm) * DIC / (DIC + Kc)

  # nutrient uptake (g g-1 C d-1), capped so pools cannot go negative
  At <- Atq(NC) * A / (A + Akt) * clamp01((NCm - NC) / (NCm - NCo))
  Pt <- Ptmax * Pw / (Pw + Pkt) * clamp01((PCm - PC) / (PCm - PCo))
  At <- pmin(At, A / (Bs * dt)); Pt <- pmin(Pt, Pw / (Bs * dt))

  Cu  <- PS - 1.5 * At - basres             # C-specific growth (Eq. 21)
  syn <- ChlCm * NP * M * Um * clamp01(1 - PS / Pqm) * clamp01(1 - ChlC / ChlCm)

  # save
  if ((step - 1) %% save_every == 0) {
    isave <- isave + 1
    t_out[isave] <- t
    for (nm in c("B", "Nq", "Pq", "Chl", "A", "Pw", "DIC"))
      O[[nm]][isave, ] <- get(nm)
    O$mu[isave, ] <- Cu; O$PS[isave, ] <- PS; O$PFD[isave, ] <- PFD
    Ntot[isave] <- sum(A + Nq) * dz
    Ptot[isave] <- sum(Pw + Pq) * dz
    Ctot[isave] <- sum(DIC + B) * dz
  }
  if (step > nt) break

  # derivatives (extensive form; mortality is fully remineralized)
  # When cells die, this ensures that the nutrients they uptook during their
  # life is re-entered into the system so that everything remains constant. 
  dB   <- B * (Cu - mort)       + transport(B, w)
  dNq  <- At * B - mort * Nq    + transport(Nq, w)
  dPq  <- Pt * B - mort * Pq    + transport(Pq, w)
  dChl <- B * syn - mort * Chl  + transport(Chl, w)
  dA   <- -At * B + mort * Nq   + transport(A)
  dPw  <- -Pt * B + mort * Pq   + transport(Pw)
  dDIC <- -Cu * B + mort * B    + transport(DIC)

  B <- pmax(B + dt * dB, 0);     Nq <- pmax(Nq + dt * dNq, 0)
  Pq <- pmax(Pq + dt * dPq, 0);  Chl <- pmax(Chl + dt * dChl, 0)
  A <- pmax(A + dt * dA, 0);     Pw <- pmax(Pw + dt * dPw, 0)
  DIC <- DIC + dt * dDIC
}
```

